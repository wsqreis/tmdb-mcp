{
  "name": "@wsqreis/tmdb-mcp",
  "version": "0.1.0",
  "description": "MCP server for The Movie Database (TMDB): compact, agent-friendly tools for movies, TV shows, people and where to watch",
  "keywords": ["mcp", "model-context-protocol", "tmdb", "movies", "llm", "ai-agents"],
  "license": "MIT",
  "author": "wsqreis",
  "type": "module",
  "bin": {
    "tmdb-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "dev:http": "node --watch src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "smoke": "node --env-file=.env scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
