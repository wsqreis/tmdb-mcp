# TMDB credentials: create them at https://www.themoviedb.org/settings/api
# The "API Read Access Token" (v4) is preferred; the v3 API key also works.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional
TMDB_LANGUAGE=en-US
TMDB_REGION=US
TMDB_CACHE_TTL_SECONDS=600
TMDB_CACHE_MAX_ENTRIES=500

# HTTP mode only (npm run dev:http / --http)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_AUTH_TOKEN=
MCP_HTTP_RATE_LIMIT_PER_MINUTE=60
